#!/usr/bin/env bash
# diskinfer Linux launcher for disktui (the diskinfer TUI).
#
# Linux counterpart of device/diskinfer.ps1 of the Windows port:
# finds a model, picks a sensible arena size, sets the disk-streaming log
# location, and execs disktui with the arguments passed through untouched.
#
#   diskinfer                                  interactive, model auto-detected
#   diskinfer "The capital of France is"       one-shot question
#   diskinfer -m ~/models/qwen.gguf --arena 1024 -n 64 "hello"
#   diskinfer -l                               list the models found
#   diskinfer -h                               full help
#
# Bare words (not starting with '-') are joined with spaces and become the
# one-shot question. Everything else after the known options is forwarded to
# disktui as-is.
#
# messages: en / zh-Hans / zh-Hant, auto-detected (contract v5 §1.3):
#   --lang CLI > DISKINFER_LANG > $LC_ALL > $LC_MESSAGES > $LANG > /etc/default/locale > en

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
# follow symlinks so the launcher can be linked into ~/.local/bin
while [ -L "$SELF" ]; do
    target="$(readlink -f -- "$SELF")"
    SELF="$target"
done
SCRIPT_DIR="$(cd -- "$(dirname -- "$SELF")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# ---------------------------------------------------------------------------
# i18n
# ---------------------------------------------------------------------------
lang_from_tag() {
    local tag
    tag="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    case "$tag" in
        *hant*|*tw*|*hk*|*mo*) printf '%s' zh-hant ;;
        zh*)                   printf '%s' zh-hans ;;
        *)                     printf '%s' en ;;
    esac
}

probe_system_lang() {
    local probe
    probe="${LC_ALL:-}"
    [ -z "$probe" ] && probe="${LC_MESSAGES:-}"
    [ -z "$probe" ] && probe="${LANG:-}"
    if [ -z "$probe" ] && [ -r /etc/default/locale ]; then
        probe="$(grep '^LANG=' /etc/default/locale 2>/dev/null | head -1 | sed 's/^LANG=//; s/^"//; s/"$//' || true)"
    fi
    printf '%s' "$probe"
}

detect_lang() {
    local explicit="${1:-}"
    if [ -z "$explicit" ] && [ -n "${DISKINFER_LANG:-}" ]; then
        explicit="$DISKINFER_LANG"
    fi
    if [ -z "$explicit" ]; then
        explicit="$(probe_system_lang)"
    fi
    lang_from_tag "$explicit"
}

# t <en> <zh-Hans> <zh-Hant>
t() {
    case "$L10N" in
        zh-hans) printf '%s' "$2" ;;
        zh-hant) printf '%s' "$3" ;;
        *)       printf '%s' "$1" ;;
    esac
}

# scan argv for --lang TAG / --lang=TAG: the launcher resolves it and exports the
# result as DISKINFER_LANG, which the new TUI (and the engine) also reads.
scan_lang_arg() {
    local prev="" a
    for a in "$@"; do
        case "$prev" in
            --lang) printf '%s' "$a"; return 0 ;;
        esac
        case "$a" in
            --lang=*) printf '%s' "${a#*=}"; return 0 ;;
        esac
        prev="$a"
    done
    return 1
}

usage() {
