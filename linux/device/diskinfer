  $DISKINFER_MODEL_DIRS (if set)
  ~/models/*.gguf
  ./models/*.gguf
  ~/Downloads/models/*.gguf
EOF
            ;;
    esac
}

warn() { printf 'diskinfer: %s\n' "$*" >&2; }

search_dirs() {
    local dir
    if [ -n "${DISKINFER_MODEL_DIRS:-}" ]; then
        local IFS=':'
        for dir in $DISKINFER_MODEL_DIRS; do
            [ -n "$dir" ] && printf '%s\n' "${dir/#\~/$HOME}"
        done
    fi
    printf '%s\n' "$HOME/models"
    printf '%s\n' "$(pwd)/models"
    printf '%s\n' "$HOME/Downloads/models"
}

find_models() { # print every *.gguf in the search dirs, sorted
    local dir
    while IFS= read -r dir; do
        [ -d "$dir" ] || continue
        find -L "$dir" -maxdepth 1 -type f -name '*.gguf' -print 2>/dev/null | LC_ALL=C sort
    done < <(search_dirs)
}

total_ram_mib() {
    if [ -r /proc/meminfo ]; then
        awk '/^MemTotal:/ { printf "%d", $2 / 1024; exit }' /proc/meminfo
    else
        # portable fallback for non-Linux (BSD/macOS): sysctl
        local bytes
        bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
        echo $(( bytes / 1048576 ))
    fi
}

default_arena_mib() {
    local total arena
    total="$(total_ram_mib)"
    [ "$total" -gt 0 ] 2>/dev/null || { echo 0; return; }
    arena=$(( total / 8 ))
    [ "$arena" -lt 176 ] && arena=176
    [ "$arena" -gt 2048 ] && arena=2048
    echo "$arena"
}

find_disktui() {
    local candidate
    for candidate in \
        "${DISKINFER_DISKTUI:-}" \
        "$SCRIPT_DIR/disktui" \
        "$REPO_ROOT/bin/disktui" \
        "$REPO_ROOT/build/out/linux-x64/disktui" \
        "$REPO_ROOT/build/build-linux/bin/llama-diskui" \
        "$REPO_ROOT/build/out/linux-x64/llama-diskui" \
        "$REPO_ROOT/src/llama.cpp-fork/build/bin/llama-diskui"
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# ---------------------------------------------------------------------------
# language: CLI --lang > DISKINFER_LANG > system
# ---------------------------------------------------------------------------
LANG_CLI=""
LANG_CLI="$(scan_lang_arg "$@" || true)"
L10N="$(detect_lang "$LANG_CLI")"
# the new TUI reads the same env var, so launcher and engine agree on the language
export DISKINFER_LANG="$L10N"

# ---------------------------------------------------------------------------
# parse arguments (same shape as the Windows launcher)
# ---------------------------------------------------------------------------
model_path=""
arena_mib=0
arena_given=0
end_of_options=0
question=()
child_args=()

value_options=(-n -c -ub -b -t -ngl --temp --top-k --top-p -q --sys --prompt --port --api-ctx)
flag_options=(--raw --chat --debug --moe --api --api-only)

while [ $# -gt 0 ]; do
    a="$1"
    next="${2:-}"
    if [ "$end_of_options" = "1" ]; then
        question+=("$a"); shift; continue
    fi
    case "$a" in
        --) end_of_options=1; shift; continue ;;
        -h|--help|-help|-\?) usage; exit 0 ;;
        --lang)  shift 2; continue ;;
        --lang=*) shift; continue ;;
        -l|--list|-list)
            models=()
            while IFS= read -r m; do [ -n "$m" ] && models+=("$m"); done < <(find_models)
            echo "$(t 'model search dirs:' '模型搜索目录:' '模型搜尋目錄:')"
            while IFS= read -r dir; do
                if [ -d "$dir" ]; then state="$(t 'exists' '存在' '存在')"; else state="$(t 'missing' '不存在' '不存在')"; fi
                printf '  %s  [%s]\n' "$dir" "$state"
            done < <(search_dirs)
            if [ "${#models[@]}" -eq 0 ]; then
                echo "$(t 'no *.gguf model found' '没有找到 *.gguf 模型' '沒有找到 *.gguf 模型')"
                exit 1
            fi
            echo
            for m in "${models[@]}"; do
                bytes=$(stat -c '%s' "$m" 2>/dev/null || echo 0)
                printf '  %10.1f MiB  %s\n' "$(awk -v b="$bytes" 'BEGIN { print b/1048576 }')" "$m"
            done
            exit 0 ;;
        -m|--model)
            [ -n "$next" ] || { warn "$(t '-m needs a model path' '-m 需要一个模型路径' '-m 需要一個模型路徑')"; exit 2; }
            model_path="$next"; shift 2; continue ;;
        --arena=*)
            text="${a#*=}"
            case "$text" in ''|*[!0-9]*) warn "$(t "--arena needs a positive number in MiB (got '$text')" "--arena 需要一个正整数（MiB，收到 '$text'）" "--arena 需要一個正整數（MiB，收到 '$text'）")"; exit 2 ;; esac
            [ "$text" -ge 1 ] 2>/dev/null || { warn "$(t "--arena needs a positive number in MiB (got '$text')" "--arena 需要一个正整数（MiB，收到 '$text'）" "--arena 需要一個正整數（MiB，收到 '$text'）")"; exit 2; }
            arena_mib="$text"; arena_given=1; shift; continue ;;
        --arena)
            [ -n "$next" ] || { warn "$(t '--arena needs a number in MiB' '--arena 需要一个数字（MiB）' '--arena 需要一個數字（MiB）')"; exit 2; }
            case "$next" in ''|*[!0-9]*) warn "$(t "--arena needs a positive number in MiB (got '$next')" "--arena 需要一个正整数（MiB，收到 '$next'）" "--arena 需要一個正整數（MiB，收到 '$next'）")"; exit 2 ;; esac
            [ "$next" -ge 1 ] 2>/dev/null || { warn "$(t "--arena needs a positive number in MiB (got '$next')" "--arena 需要一个正整数（MiB，收到 '$next'）" "--arena 需要一個正整數（MiB，收到 '$next'）")"; exit 2; }
            arena_mib="$next"; arena_given=1; shift 2; continue ;;
    esac
    matched=0
    for opt in "${value_options[@]}"; do
        if [ "$a" = "$opt" ]; then
            child_args+=("$a")
            if [ -n "$next" ]; then child_args+=("$next"); shift 2; else shift; fi
            matched=1; break
        fi
    done
    [ "$matched" = "1" ] && continue
    for opt in "${flag_options[@]}"; do
        if [ "$a" = "$opt" ]; then child_args+=("$a"); shift; matched=1; break; fi
    done
    [ "$matched" = "1" ] && continue
    case "$a" in
        -*) child_args+=("$a"); shift; continue ;;
        *)  question+=("$a"); shift; continue ;;
    esac
done

# ---------------------------------------------------------------------------
# resolve the model
# ---------------------------------------------------------------------------
if [ -z "$model_path" ]; then
    models=()
    while IFS= read -r m; do [ -n "$m" ] && models+=("$m"); done < <(find_models)
    if [ "${#models[@]}" -eq 1 ]; then
        model_path="${models[0]}"
    elif [ "${#models[@]}" -eq 0 ]; then
        echo "$(t 'diskinfer: no .gguf model found' 'diskinfer: 没有找到 .gguf 模型' 'diskinfer: 沒有找到 .gguf 模型')"
        echo "$(t 'searched:' '搜索过:' '搜尋過:')"
        while IFS= read -r dir; do
            if [ -d "$dir" ]; then state="$(t 'no *.gguf inside' '目录里没有 *.gguf' '目錄裡沒有 *.gguf')"; else state="$(t 'missing' '不存在' '不存在')"; fi
            printf '  %s  [%s]\n' "$dir" "$state"
        done < <(search_dirs)
        echo
        echo "$(t 'put a .gguf model in one of those dirs, or pass -m PATH' '把 .gguf 模型放进上面任一目录，或者用 -m PATH 指定' '把 .gguf 模型放進上面任一目錄，或者用 -m PATH 指定')"
        exit 1
    else
        printf '%s\n' "$(t "diskinfer: found ${#models[@]} .gguf models, pass -m PATH to choose one:" "diskinfer: 找到 ${#models[@]} 个 .gguf 模型，用 -m PATH 选一个:" "diskinfer: 找到 ${#models[@]} 個 .gguf 模型，用 -m PATH 選一個:")"
        printf '  %s\n' "${models[@]}"
        exit 2
    fi
else
    [ -f "$model_path" ] || { warn "$(t "model not found: $model_path" "模型不存在: $model_path" "模型不存在: $model_path")"; exit 1; }
    model_path="$(cd -- "$(dirname -- "$model_path")" && pwd)/$(basename -- "$model_path")"
fi

# ---------------------------------------------------------------------------
# locate disktui
# ---------------------------------------------------------------------------
disktui="$(find_disktui || true)"
if [ -z "$disktui" ]; then
    echo "$(t 'diskinfer: disktui not found. looked for:' 'diskinfer: 没有找到 disktui。找过:' 'diskinfer: 沒有找到 disktui。找過:')"
    [ -n "${DISKINFER_DISKTUI:-}" ] && printf '  %s  (DISKINFER_DISKTUI)\n' "$DISKINFER_DISKTUI"
    printf '  %s\n' "$SCRIPT_DIR/disktui" "$REPO_ROOT/bin/disktui" \
        "$REPO_ROOT/build/out/linux-x64/disktui" "$REPO_ROOT/build/build-linux/bin/llama-diskui"
    echo
    echo "$(t 'build it first:' '请先构建:' '請先建置:')"
    echo "  $REPO_ROOT/build/build-linux.sh"
    exit 1
fi

# ---------------------------------------------------------------------------
# environment defaults
# ---------------------------------------------------------------------------
if [ "$arena_given" = "0" ]; then
    arena_mib="$(default_arena_mib)"
fi
if [ "$arena_mib" -gt 0 ]; then
    # the disk engine reads the arena size from LLAMA_DISK_STREAM_MB; we do not
    # pass --arena to disktui because older builds would treat the number as the
    # question text
    export LLAMA_DISK_STREAM_MB="$arena_mib"
fi

if [ -z "${LLAMA_DISK_LOG:-}" ]; then
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/diskinfer"
    if mkdir -p "$state_dir" 2>/dev/null; then
        export LLAMA_DISK_LOG="$state_dir/diskinfer.log"
    else
        export LLAMA_DISK_LOG="${TMPDIR:-/tmp}/diskinfer.log"
    fi
fi

# ---------------------------------------------------------------------------
# run
# ---------------------------------------------------------------------------
run_args=(-m "$model_path")
if [ "${#child_args[@]}" -gt 0 ]; then run_args+=("${child_args[@]}"); fi
if [ "${#question[@]}" -gt 0 ]; then
    joined=""
    for word in "${question[@]}"; do
        if [ -n "$joined" ]; then joined="$joined $word"; else joined="$word"; fi
    done
    run_args+=("$joined")
fi

echo "$(t "diskinfer: model $model_path" "diskinfer: 模型 $model_path" "diskinfer: 模型 $model_path")"
[ "$arena_mib" -gt 0 ] && echo "$(t "diskinfer: arena $arena_mib MiB" "diskinfer: arena $arena_mib MiB" "diskinfer: arena $arena_mib MiB")"
echo "$(t "diskinfer: log $LLAMA_DISK_LOG" "diskinfer: 日志 $LLAMA_DISK_LOG" "diskinfer: 日誌 $LLAMA_DISK_LOG")"
echo "$(t "diskinfer: exec $disktui" "diskinfer: 执行 $disktui" "diskinfer: 執行 $disktui")"
exec "$disktui" "${run_args[@]}"
