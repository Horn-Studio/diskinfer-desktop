EOF
            ;;
        *)
            cat <<'EOF'
usage: diskinfer [question words...]
       diskinfer -m PATH [--arena MiB] [question words...] [engine args]

  -m PATH        model file (.gguf). if omitted, exactly one *.gguf is searched
                 for in: ~/models, ./models, ~/Downloads/models (several models
                 -> exit 2, none -> exit 1)
  --arena MiB    weight arena size (sets LLAMA_DISK_STREAM_MB; the engine raises
                 it to fit the largest tensor and caps it at 2048 MiB)
                 default = total RAM / 8, clamped to 176..2048 MiB
  --lang TAG     UI language for the launcher and the TUI (exported to the
                 engine as DISKINFER_LANG): auto / en / zh-Hans / zh-Hant
  -n N           max tokens to generate (default 256, capped by ctx)
  -c N           context size (default 256)
  -ub N          prefill batch (default 4; 1 = least RAM, slowest prefill)
  -t N           threads (default 4, try 8-16 on a desktop)
  --temp F       sampling temperature (default 1.0)
  --top-k N      default 20
  --top-p F      default 0.95
  --raw          raw completion prompt (default)
  --chat         use the chat template with thinking off
  --sys "text"   system message for --chat
  --debug        verbose disk-streaming diagnostics (LLAMA_DISK_DEBUG=1)
  --moe          start with the MoE expert fast path enabled (LLAMA_DISK_MOE=1)
  --api          start with the in-process OpenAI-compatible API on port 4000
  --api-only     no TUI, API server only (headless: servers / background)
  --port N       API port (default 4000)
  -l, --list     list the models found in the search dirs and exit
  -h, --help     show this help and exit

environment:
  LLAMA_DISK_LOG       default: $XDG_STATE_HOME/diskinfer/diskinfer.log
                       (~/.local/state/diskinfer/diskinfer.log) or /tmp
  LLAMA_DISK_STREAM_MB arena size in MiB (--arena overrides it)
  DISKINFER_DISKTUI    explicit path to the disktui binary (for testing side builds)
  DISKINFER_MODEL_DIRS extra model search dirs, colon separated
  DISKINFER_LANG       UI language override (en / zh-Hans / zh-Hant)

examples:
  diskinfer "The capital of France is"
  diskinfer -m ~/models/qwen.gguf --arena 1024 -n 64 --chat "hello"

